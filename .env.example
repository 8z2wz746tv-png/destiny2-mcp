# Bungie API credentials — https://www.bungie.net/en/Application
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# Optional: OAuth callback URI. Must exactly match a redirect URL configured
# in Bungie Developer Portal. The local login helper defaults to:
# DESTINY_OAUTH_REDIRECT_URI=https://localhost:8765/callback

# Optional: default player name (e.g. "PlayerName#1234")
# DESTINY_DEFAULT_PLAYER=

# Optional: visible MCP tool surface.
# normal = 8 assistant aggregate tools (recommended)
# expert = assistants + common read-only legacy tools
# full = assistants + all legacy tools for debugging/compatibility
# DESTINY_MCP_TOOL_PROFILE=normal

# Optional: DIM wish list data path. If missing, MCP auto-downloads it.
# DESTINY_WISHLIST_PATH=~/.destiny_mcp/data/dim_wishlists.json

# Optional: override the bundled Starside Markdown directory.
# STARSIDE_SHARE_PATH=/path/to/starside-markdown

# Optional: transport (stdio or sse)
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
